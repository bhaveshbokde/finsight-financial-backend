# FinSight — environment template
# --------------------------------
# Copy to `.env` and fill in real values, OR run:
#     sudo bash scripts/provision-db.sh
# which creates the database/role and writes a `.env` with generated secrets.
#
# `.env` is listed in .gitignore. NEVER commit real secrets.
# Every value below is a PLACEHOLDER.

# ---------- PostgreSQL ----------
FINSIGHT_DB_URL=jdbc:postgresql://127.0.0.1:5432/finsight_db
FINSIGHT_DB_USERNAME=finsight_app
FINSIGHT_DB_PASSWORD=replace-with-a-generated-password

# Database used by integration tests (mvn verify -Pintegration)
FINSIGHT_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/finsight_test_db

# ---------- JWT ----------
# HS256 signing key. MUST be >= 256 bits of entropy, base64-encoded.
# Generate with:  head -c 64 /dev/urandom | base64 | tr -d '\n'
FINSIGHT_JWT_SECRET=replace-with-a-base64-encoded-256-bit-or-longer-random-key
FINSIGHT_JWT_ACCESS_TTL=PT30M
FINSIGHT_JWT_REFRESH_TTL=P7D
FINSIGHT_JWT_ISSUER=finsight

# ---------- Redis ----------
FINSIGHT_REDIS_HOST=localhost
FINSIGHT_REDIS_PORT=6379
# Leave empty when Redis has no password (default for the bundled compose file).
FINSIGHT_REDIS_PASSWORD=

# ---------- Kafka ----------
# From the host:                 localhost:9092
# From inside a compose network: kafka:29092
FINSIGHT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FINSIGHT_KAFKA_CONSUMER_GROUP=finsight-import-processor

# ---------- App ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
FINSIGHT_IMPORT_MAX_FILE_SIZE=5MB
FINSIGHT_IMPORT_MAX_ROWS=50000
